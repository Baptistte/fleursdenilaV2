PORT=3000
FRONTEND_URL=http://localhost:5500

# Session
SESSION_SECRET=change-this-to-a-random-string

# SumUp (sandbox)
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=
SUMUP_MERCHANT_CODE=
# Secret de signature du webhook (obligatoire : sans lui le webhook est refusé)
