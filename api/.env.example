# Resend (emails)
RESEND_API_KEY=

# Instagram (flux photos de la page d'accueil) — jeton longue durée de l'API Instagram
INSTAGRAM_ACCESS_TOKEN=

# Destinataire des notifications internes (commandes, devis) — défaut : staff.daffodil@gmail.com
ADMIN_NOTIF_EMAIL=
# Expéditeur des emails (domaine validé chez Resend)
MAIL_FROM=Fleurs de Nila <boutique@fleursdenila.fr>
